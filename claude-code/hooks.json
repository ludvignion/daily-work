{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${DAILY_WORK_TELEMETRY:-}\" = 0 ] || bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-py.sh\" telemetry.py hook; true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${DAILY_WORK_CONTENT:-}\" = 0 ] || bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-py.sh\" content.py hook; true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${DAILY_WORK_CONTENT:-}\" = 0 ] || bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-py.sh\" content.py hook; true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${DAILY_WORK_CONTENT:-}\" = 0 ] || bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-py.sh\" content.py hook; true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "[ \"${DAILY_WORK_TELEMETRY:-}\" = 0 ] || bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-py.sh\" telemetry.py stop; true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
