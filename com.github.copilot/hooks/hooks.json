{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "bash": "[ \"${DAILY_WORK_TELEMETRY:-}\" = 0 ] || bash \"$PLUGIN_ROOT/scripts/run-py.sh\" telemetry.py hook copilot; true",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "[ \"${DAILY_WORK_CONTENT:-}\" = 0 ] || bash \"$PLUGIN_ROOT/scripts/run-py.sh\" content.py hook copilot-prompt; true",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "[ \"${DAILY_WORK_CONTENT:-}\" = 0 ] || bash \"$PLUGIN_ROOT/scripts/run-py.sh\" content.py hook copilot-stop; true",
        "timeoutSec": 5
      },
      {
        "type": "command",
        "bash": "[ \"${DAILY_WORK_TELEMETRY:-}\" = 0 ] || bash \"$PLUGIN_ROOT/scripts/run-py.sh\" telemetry.py stop; true",
        "timeoutSec": 5
      }
    ]
  }
}
